<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_large">

        <!-- Page header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Analysis Results"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂  Home"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#E60023"
                android:backgroundTint="#FFFFFF"
                android:minHeight="40dp"
                android:minWidth="0dp"/>

        </LinearLayout>

        <!-- Analyzed shelf image with bounding boxes -->
        <ImageView
            android:id="@+id/imgAnalyzedShelf"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="#F5F5F5"
            android:contentDescription="Analyzed shelf image"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Facings"
            android:textColor="#666666"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtTotalProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#000000"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRODUCTS DETECTED"
            android:textColor="#777777"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/txtColaCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coca-Cola ×0"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtColaVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visibility: 0.0%"
                android:textColor="#E60023"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/txtFantaCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fanta ×0"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtFantaVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visibility: 0.0%"
                android:textColor="#E60023"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/txtSpriteCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sprite ×0"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtSpriteVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visibility: 0.0%"
                android:textColor="#E60023"
                android:textSize="13sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtEmptySpaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empty shelf space detection not yet available"
            android:textColor="#666666"
            android:textStyle="bold"
            android:background="#F5F5F5"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnGenerateReport"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Generate Report"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#E60023"/>

    </LinearLayout>

</ScrollView>