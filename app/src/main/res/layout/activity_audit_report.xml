<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_large">

        <!-- Page header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audit Report"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂  Home"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#E60023"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report ID"
            android:textColor="#777777"/>

        <TextView
            android:id="@+id/txtReportId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RPT-001"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="#777777"/>

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24 June 2026"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtColaCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coca-Cola: 0"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtFantaCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fanta: 0"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtSpriteCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sprite: 0"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtTotalFacings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Facings: 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E60023"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveReport"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Report"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E60023"/>

    </LinearLayout>

</ScrollView>